# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#   CSR SYSTEM  ·  Powered by Breezy
#   Configure once — works across all servers
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ─── Bot ──────────────────────────────────────
BOT_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here

# ─── Web Server ───────────────────────────────
WEB_PORT=3000
WEB_BASE_URL=http://localhost:3000
# Production: WEB_BASE_URL=https://yourdomain.com

# ─── AI — Gemini (external chat) ──────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Get free key: aistudio.google.com

# ─── AI — Groq (internal, rotating) ──────────
GROQ_API_KEY=your_groq_api_key_here
# Get free key: console.groq.com

# ─── YouTube Data API v3 ──────────────────────
YOUTUBE_API_KEY=your_youtube_api_key_here
# Get free key: console.cloud.google.com

# ─── Steam Web API ────────────────────────────
STEAM_API_KEY=your_steam_api_key_here
# Get free key: steamcommunity.com/dev/apikey

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Per-server config is set via bot commands:
#   .csrsbor      → Sword Blox Online Rebirth
#   .csrbh2       → Blue Heater 2
#   .csrbf        → Blox Fruits
#   .csrwarframe  → Warframe
# Bot walks you through setup interactively!
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
