# ─── Bot Config ───────────────────────────────────────
BOT_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here

# ─── Roles (copy the role IDs from Discord) ───────────
VERIFIED_ROLE_ID=role_id_for_verified
UNVERIFIED_ROLE_ID=role_id_for_unverified

# ─── Channels ─────────────────────────────────────────
BACKUP_CHANNEL_ID=channel_id_for_data_backup
LOG_CHANNEL_ID=channel_id_for_logs
WELCOME_CHANNEL_ID=channel_id_for_welcome_messages

# ─── Web Server (for OTP verification page) ───────────
WEB_PORT=3000
WEB_BASE_URL=http://localhost:3000
# Example prod: WEB_BASE_URL=https://yourdomain.com

# ─── Guild Info ───────────────────────────────────────
GUILD_NAME=Champions of the Shattered Realm
